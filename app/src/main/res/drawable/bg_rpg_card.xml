<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer retro gold stepped frame -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_screen" />
            <corners android:radius="4dp" />
            <stroke
                android:width="2dp"
                android:color="@color/accent_gold" />
        </shape>
    </item>
    <!-- Inner elevated slate surface with hairline border -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface" />
            <corners android:radius="2dp" />
            <stroke
                android:width="1dp"
                android:color="@color/card_stroke" />
        </shape>
    </item>
</layer-list>
